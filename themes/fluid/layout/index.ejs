%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>海澄｜项目展示主页</title>
  <meta name="description" content="海澄的项目展示主页，聚焦游戏研究、用户洞察、AI 工作流与叙事项目。">
  <link rel="stylesheet" href="<%= base('/css/custom.css') %>">
</head>
<body class="portfolio-home home-page">
  <div class="gate-overlay" id="gateOverlay" aria-hidden="false">
    <div class="gate-grid"></div>
    <div class="gate-inner">
      <p class="gate-kicker">HAICHENG PORTFOLIO</p>
      <h1 class="gate-title">海的那边…</h1>
      <p class="gate-text">点击按钮进入主页</p>
      <a class="gate-enter" href="#homeContent" id="gateEnter">进入主页</a>
      <div class="gate-indicator" aria-hidden="true"><span></span></div>
    </div>
  </div>

  <aside class="project-drawer" id="projectDrawer" aria-hidden="true">
    <div class="drawer-head">
      <div>
        <p class="drawer-kicker">PROJECTS</p>
        <h2>项目预览</h2>
      </div>
      <button class="drawer-close" id="drawerClose" type="button" aria-label="关闭">×</button>
    </div>

    <div class="drawer-list">
      <% featuredProjects.concat(toolProjects).forEach(function(project) { %>
        <article class="drawer-card click-card" data-url="<%= project.url %>">
          <div class="drawer-cover">
            <img class="cover-fit <%= project.coverClass %>" src="<%= project.cover %>" alt="<%= project.alt %>">
          </div>
          <div class="drawer-body">
            <h3><%= project.title %></h3>
            <p><%= project.desc %></p>
            <span class="drawer-link"><%= project.primaryAction %></span>
          </div>
        </article>
      <% }); %>
    </div>
  </aside>

  <div class="drawer-mask" id="drawerMask" aria-hidden="true"></div>

  <header class="topbar">
    <div class="shell topbar-inner">
      <nav class="navlinks">
        <button class="nav-project-trigger" id="projectTrigger" type="button">项目</button>
      </nav>
    </div>
  </header>

  <main id="homeContent">
    <section class="hero-intro shell reveal">
      <div class="hero-layout">
        <div class="hero-portrait-column">
          <div class="hero-portrait-card">
            <img class="hero-portrait" src="<%= heroPortrait %>" alt="海澄个人形象图">
          </div>
          <p class="hero-quote">I think therefore I am</p>
        </div>

        <div class="hero-copy">
          <p class="eyebrow">GAME RESEARCH · USER INSIGHTS · WORKFLOW DESIGN</p>
          <h1 class="hero-title">游戏研究｜用户洞察｜研究型工作流</h1>
          <p class="hero-desc hero-desc-kaiti">
            你好！我是海澄<br>
            应用心理学背景，正在关注用户研究与自动化工作流开发。<br>
            这里整理我目前公开的研究、系统与叙事项目。它们分别对应游戏用户洞察、研究型实验设计、AI 工作流与作品化表达几个方向。
          </p>
          <div class="hero-actions">
            <a class="pill-button pill-primary" href="<%= githubUrl %>" target="_blank" rel="noopener noreferrer">查看 GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <section class="shell project-tier project-tier-featured reveal">
      <div class="section-head project-tier-head">
        <p class="section-kicker">FEATURED</p>
        <h2>精选项目</h2>
      </div>

      <div class="primary-project-grid">
        <% featuredProjects.forEach(function(project) { %>
          <article class="featured-card project-main-card click-card" data-url="<%= project.url %>">
            <a class="featured-cover" href="<%= project.url %>" target="_blank" rel="noopener noreferrer">
              <img class="cover-fit <%= project.coverClass %>" src="<%= project.cover %>" alt="<%= project.alt %>">
            </a>
            <div class="featured-content">
              <div class="meta-row">
                <span class="meta-date"><%= project.date %></span>
                <% if (project.status) { %><span class="status-badge"><%= project.status %></span><% } %>
              </div>
              <h3><a href="<%= project.url %>" target="_blank" rel="noopener noreferrer"><%= project.title %></a></h3>
              <p class="card-lead"><%= project.desc %></p>
              <div class="tag-row">
                <% project.tags.forEach(function(tag) { %><span><%= tag %></span><% }); %>
              </div>
              <div class="project-actions">
                <a class="text-link" href="<%= project.url %>" target="_blank" rel="noopener noreferrer"><%= project.primaryAction %></a>
                <a class="text-link text-link-secondary" href="<%= project.repo %>" target="_blank" rel="noopener noreferrer">源码仓库</a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="shell project-tier project-tier-tools reveal">
      <div class="section-head project-tier-head">
        <p class="section-kicker">SYSTEMS & TOOLS</p>
        <h2>系统与工具</h2>
      </div>

      <div class="tool-project-grid">
        <% toolProjects.forEach(function(project) { %>
          <article class="project-card project-tool-card click-card" data-url="<%= project.url %>">
            <a class="project-cover" href="<%= project.url %>" target="_blank" rel="noopener noreferrer">
              <img class="cover-fit <%= project.coverClass %>" src="<%= project.cover %>" alt="<%= project.alt %>">
            </a>
            <div class="project-body">
              <div class="meta-row">
                <span class="meta-date"><%= project.date %></span>
                <% if (project.status) { %><span class="status-badge"><%= project.status %></span><% } %>
              </div>
              <h3><a href="<%= project.url %>" target="_blank" rel="noopener noreferrer"><%= project.title %></a></h3>
              <p class="card-desc"><%= project.desc %></p>
              <div class="tag-row">
                <% project.tags.forEach(function(tag) { %><span><%= tag %></span><% }); %>
              </div>
              <div class="project-actions">
                <a class="text-link" href="<%= project.url %>" target="_blank" rel="noopener noreferrer"><%= project.primaryAction %></a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>
  </main>

  <script src="<%= base('/js/site-ui.js') %>"></script>
</body>
</html>
