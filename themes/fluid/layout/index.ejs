var toolProjects = [
  {
    title: 'Desktop Doc Execution Studio',
    date: '2026年4月13日',
    desc: '面向文档执行与结果整理的桌面应用，聚焦文档任务拆解、执行跟踪与结果归档。',
    tags: ['桌面应用', '文档流程', '执行工具'],
    url: 'https://github.com/sherlock0717/desktop-doc-execution-studio',
    primaryAction: '查看仓库',
